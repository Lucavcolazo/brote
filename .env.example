# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# npm run vapid → la "Public Key"
VITE_VAPID_PUBLIC_KEY=

# Los emails de las 2 cuentas creadas en Supabase > Authentication > Users
VITE_LUCA_EMAIL=
VITE_GIOVANNA_EMAIL=

# Si no cargás VITE_SUPABASE_URL la app arranca en modo demo (datos de mentira).
